{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    },
    "Retry": {
      "BaseDelaySeconds": 2,
      "MaxDelaySeconds": 300,
      "UseJitter": true
    }
  },
  "Worker": {
    "PollingIntervalMilliseconds": 1000
  }
}
